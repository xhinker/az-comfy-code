{
    // Interpreter and Jupyter kernel: Ctrl+Enter obeys the kernel, not the status bar.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "jupyter.interactiveWindow.creationMode": "perFile",
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    // Cell markers from az_samples: # %%, # COMMAND, # <codecell> and In[..] all split cells.
    "jupyter.interactiveWindow.cellMarker.codeRegex": "^(#\\s*COMMAND\\s*[-]*|#\\s*%%|#\\s*\\<codecell\\>|#\\s*In\\[\\d*?\\]|#\\s*In\\[ \\])",

    // Pylance: resolve `import moss_image_gen` from the repo root, and index the venv.
    "python.analysis.extraPaths": [
        "${workspaceFolder}/moss_image"
    ],
    "python.analysis.autoSearchPaths": true,

    // Don't let the watcher crawl the 5.6 GiB venv, the weight cache or generated images.
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.offload_cache/**": true,
        "**/outputs/**": true,
        "**/out/**": true,
        "**/node_modules/*/**": true
    },

    // Editor basics carried over from az_samples (workspace-scoped ones only).
    "editor.tabSize": 4,
    "editor.fontSize": 14,
    "editor.rulers": [20, 40, 60, 80],
    "editor.minimap.enabled": false,
    "editor.tabCompletion": "on",
    "editor.acceptSuggestionOnEnter": "off",
    "editor.copyWithSyntaxHighlighting": false,
    "editor.guides.indentation": true,
    "editor.hover.enabled": "on",
    "files.eol": "\n",
    "git.ignoreLimitWarning": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "cSpell.words": [
        "comfyui",
        "diffusers",
        "ipykernel",
        "moss",
        "safetensors",
        "torchao"
    ]
}
